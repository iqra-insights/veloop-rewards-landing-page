{
  "name": "veloop-rewards-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc -b",
    "build:standalone": "vite build --config vite.standalone.config.ts --mode standalone",
    "test:browser": "node tests/browser.smoke.mjs",
    "format": "prettier --write src tests *.json vite*.ts README.md THIRD_PARTY_NOTICES.md",
    "format:check": "prettier --check src tests *.json vite*.ts README.md THIRD_PARTY_NOTICES.md"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.10",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
